# Copie para .env e preencha
ANTHROPIC_API_KEY=sk-ant-...

# Modelo e esforço de raciocínio (low | medium | high | xhigh | max). low = mais econômico
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low

# Banco vetorial (docker compose up -d)
DATABASE_URL=postgresql://rag:rag@localhost:5433/primeiros_socorros

# Embeddings (fastembed, roda local em CPU)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# RAG
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5

# Backend
BACKEND_URL=http://localhost:8000
